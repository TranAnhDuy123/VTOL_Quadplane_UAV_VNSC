          <izz>1859.46e-09</izz>
        </inertia>
      </inertial>
      <visual name="right_rudder_visual">
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://VTOL_Quadplane/meshes/My_Right_rudder.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>
    <joint name="right_rudder_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_rudder_link</child>
      <pose relative_to="base_link">-0.55172 -0.23968 0.1218 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.436332313</lower>
          <upper>0.436332313</upper>
        </limit>
        <dynamics>
          <damping>0.1</damping>
        </dynamics>
      </axis>
    </joint>

