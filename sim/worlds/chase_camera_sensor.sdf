      <!-- Inserted into the aircraft's base_link by sim/run_gazebo_sitl.sh
           (MODEL_INSERT; fixed-wing recording only). A camera 3.4 m behind,
           1.1 m right of and 0.8 m above the aircraft origin, looking at it.
           It is fixed to the airframe, so the render has no lag or jitter, and
           a sensor has no mass, so the flight dynamics are unchanged.
           analysis/fw_video.py turns each frame by the camera's roll to level
           the horizon and crops 960 x 540 around the aircraft; the square
           1200 px image leaves room for that at any roll angle. -->
      <sensor name="chase_cam" type="camera">
        <pose>-3.4 -1.1 0.8 0 0.2202 0.3129</pose>
        <camera>
          <horizontal_fov>1.1537</horizontal_fov>
          <image>
            <width>1200</width>
            <height>1200</height>
          </image>
          <clip>
            <near>0.1</near>
            <far>3000</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
        <topic>chase_cam</topic>
      </sensor>
