diff --git a/libraries/AC_AttitudeControl/AC_AttitudeControl_INDI.cpp b/libraries/AC_AttitudeControl/AC_AttitudeControl_INDI.cpp
new file mode 100644
index 0000000000..56c0b84cbc
--- /dev/null
+++ b/libraries/AC_AttitudeControl/AC_AttitudeControl_INDI.cpp
@@ -0,0 +1,124 @@
+#include "AC_AttitudeControl_INDI.h"
+
+#include <AP_HAL/AP_HAL.h>
+#include <AP_InertialSensor/AP_InertialSensor.h>
+#include <AP_Logger/AP_Logger.h>
+#include <AP_Scheduler/AP_Scheduler.h>
+
+AC_AttitudeControl_INDI::AC_AttitudeControl_INDI(AP_AHRS_View &ahrs, AP_MotorsMulticopter& motors, const AC_INDI_Params &indi) :
+    AC_AttitudeControl_TS(ahrs, motors),
+    _indi(indi),
+    _active(0)
+{
+}
+
+float AC_AttitudeControl_INDI::applied_input(uint8_t axis)
+{
+    if (axis > 1) {
+        // no yaw factor accessor on the motor class: use the last request
+        return _motors.get_yaw() + _motors.get_yaw_ff();
+    }
+    // Each motor output is thr_lin.thrust_to_actuator(thrust_i), with
+    //   thrust_i = throttle*throttle_factor_i + scale*(roll*roll_factor_i + pitch*pitch_factor_i + yaw*yaw_factor_i)
+    // Projecting the recovered thrusts onto the roll (or pitch) factors gives the
+    // roll (or pitch) input that was actually applied, after any rescaling.
+    float num = 0.0f, den = 0.0f;
+    for (uint8_t i = 0; i < AP_MOTORS_MAX_NUM_MOTORS; i++) {
+        float act;
+        if (!_motors_multi.get_raw_motor_throttle(i, act)) {
+            continue;
+        }
+        const float f = (axis == 0) ? _motors_multi.get_roll_factor(i) : _motors_multi.get_pitch_factor(i);
+        if (is_zero(f)) {
+            continue;
+        }
+        num += f * _motors_multi.thr_lin.actuator_to_thrust(act);
+        den += f * f;
+    }
+    if (!is_positive(den)) {
+        return 0.0f;
+    }
+    const float comp = _motors_multi.thr_lin.get_compensation_gain();
+    return num / den / (is_positive(comp) ? comp : 1.0f);
+}
+
+void AC_AttitudeControl_INDI::rate_controller_run_dt(const Vector3f& gyro_rads, float dt)
+{
+    // same bookkeeping as AC_AttitudeControl_Multi::rate_controller_run_dt()
+    Vector3f ang_vel_body = _ang_vel_body_rads;
+    update_throttle_gain_boost();
+    update_throttle_rpy_mix();
+    ang_vel_body += _sysid_ang_vel_body_rads;
+    _rate_gyro_rads = gyro_rads;
+    _rate_gyro_time_us = AP_HAL::micros64();
+
+    const float loop_hz = AP::scheduler().get_loop_rate_hz();
+    const float gyro_hz = AP::ins().get_gyro_filter_hz();
+    const bool spooled = _motors.get_spool_state() == AP_Motors::SpoolState::THROTTLE_UNLIMITED;
+    static const AC_INDI_Params::Axis bits[3] { AC_INDI_Params::MC_ROLL, AC_INDI_Params::MC_PITCH, AC_INDI_Params::MC_YAW };
+    AC_PID *pids[3] { &get_rate_roll_pid(), &get_rate_pitch_pid(), &get_rate_yaw_pid() };
+    const bool limits[3] { _motors.limit.roll, _motors.limit.pitch, _motors.limit.yaw };
+
+    float out[3];
+    _active = 0;
+    for (uint8_t i = 0; i < 3; i++) {
+        _axis[i].configure(loop_hz, gyro_hz, _indi.filt_hz, _indi.act_tc, _indi.act_dly);
+        const float u_app = applied_input(i);
+        const bool use_indi = spooled && _indi.axis_enabled(bits[i]) && is_positive(_indi.g[i].get());
+        if (use_indi) {
+            const float nu = _indi.k[i] * (ang_vel_body[i] - gyro_rads[i]);
+            out[i] = _axis[i].update(gyro_rads[i], u_app, nu, _indi.g[i]);
+            // keep the PID object consistent: its target is read by the
+            // fixed-wing surfaces slaved to the VTOL rate loop, and a zero
+            // integrator makes a later hand-back to PID bumpless
+            pids[i]->set_target_rate(ang_vel_body[i]);
+            pids[i]->set_actual_rate(gyro_rads[i]);
+            pids[i]->reset_I();
+            _active |= (1U << i);
+        } else {
+            out[i] = pids[i]->update_all(ang_vel_body[i], gyro_rads[i], dt, limits[i], _pd_scale[i], _i_scale[i]);
+            _axis[i].reset(gyro_rads[i], u_app);
+        }
+    }
+
+    _motors.set_roll(out[0] + _actuator_sysid.x);
+    _motors.set_roll_ff((_active & 1U) ? 0.0f : get_rate_roll_pid().get_ff());
+    _motors.set_pitch(out[1] + _actuator_sysid.y);
+    _motors.set_pitch_ff((_active & 2U) ? 0.0f : get_rate_pitch_pid().get_ff());
+    _motors.set_yaw(out[2] + _actuator_sysid.z);
+    _motors.set_yaw_ff((_active & 4U) ? 0.0f : get_rate_yaw_pid().get_ff() * _feedforward_scalar);
+
+    _pd_scale_used = _pd_scale;
+    _i_scale_used = _i_scale;
+    _angle_P_scale_used = _angle_P_scale;
+
+    write_log();
+}
+
+void AC_AttitudeControl_INDI::write_log() const
+{
+#if HAL_LOGGING_ENABLED
+// @LoggerMessage: INDI
+// @Description: VTOL INDI rate loop (normalised mixer units, rad/s/s)
+// @Field: TimeUS: Time since system startup
+// @Field: Act: axes running INDI (1 roll, 2 pitch, 4 yaw)
+// @Field: RNu: roll desired angular acceleration
+// @Field: RWd: roll filtered measured angular acceleration
+// @Field: RU0: roll filtered applied mixer input
+// @Field: RU: roll INDI command
+// @Field: PNu: pitch desired angular acceleration
+// @Field: PWd: pitch filtered measured angular acceleration
+// @Field: PU0: pitch filtered applied mixer input
+// @Field: PU: pitch INDI command
+// @Field: YNu: yaw desired angular acceleration
+// @Field: YWd: yaw filtered measured angular acceleration
+// @Field: YU0: yaw filtered applied mixer input
+// @Field: YU: yaw INDI command
+    AP::logger().WriteStreaming("INDI", "TimeUS,Act,RNu,RWd,RU0,RU,PNu,PWd,PU0,PU,YNu,YWd,YU0,YU",
+                                "s-------------", "F-------------", "QBffffffffffff",
+                                AP_HAL::micros64(), _active,
+                                _axis[0].nu, _axis[0].wdot_f, _axis[0].u0_f, _axis[0].u,
+                                _axis[1].nu, _axis[1].wdot_f, _axis[1].u0_f, _axis[1].u,
+                                _axis[2].nu, _axis[2].wdot_f, _axis[2].u0_f, _axis[2].u);
+#endif
+}
