new file mode 100644
index 0000000000..e4511afcc6
--- /dev/null
+++ b/libraries/AC_AttitudeControl/AC_AttitudeControl_INDI.h
@@ -0,0 +1,39 @@
+#pragma once
+
+/// @file    AC_AttitudeControl_INDI.h
+/// @brief   QuadPlane VTOL attitude control with an INDI body-rate loop
+
+#include "AC_AttitudeControl_TS.h"
+#include "AC_INDI.h"
+
+/*
+  Same as AC_AttitudeControl_TS (angle loop, throttle handling, tailsitter
+  helpers) except for the body-rate loop: axes enabled in Q_INDI_AXES with a
+  non-zero effectiveness use INDI, the others keep the stock PID.
+
+  The effector feedback u0 is what the mixer actually applied last loop,
+  recovered from the motor outputs, so mixer saturation, yaw headroom, slew
+  and the thrust curve are all included.
+ */
+class AC_AttitudeControl_INDI : public AC_AttitudeControl_TS
+{
+public:
+    AC_AttitudeControl_INDI(AP_AHRS_View &ahrs, AP_MotorsMulticopter& motors, const AC_INDI_Params &indi);
+
+    virtual ~AC_AttitudeControl_INDI() {}
+
+    void rate_controller_run_dt(const Vector3f& gyro_rads, float dt) override;
+
+    // bitmask of axes (1 roll, 2 pitch, 4 yaw) that ran INDI in the last loop
+    uint8_t indi_active_mask() const { return _active; }
+
+private:
+    // mixer roll/pitch/yaw input that the motors actually applied last loop
+    float applied_input(uint8_t axis);
+
+    void write_log() const;
+
+    const AC_INDI_Params &_indi;
+    AC_INDI_Axis _axis[3];
+    uint8_t _active;
+};
