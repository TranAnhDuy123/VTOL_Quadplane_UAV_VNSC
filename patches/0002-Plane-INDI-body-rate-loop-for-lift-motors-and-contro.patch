+AC_INDI_Params::AC_INDI_Params()
+{
+    AP_Param::setup_object_defaults(this, var_info);
+}
+
+void AC_INDI_Axis::configure(float loop_hz, float gyro_filt_hz, float filt_hz, float act_tc, float act_dly)
+{
+    if (is_equal(loop_hz, _loop_hz) && is_equal(gyro_filt_hz, _gyro_hz) &&
+        is_equal(filt_hz, _filt_hz) && is_equal(act_tc, _tc) && is_equal(act_dly, _dly)) {
+        return;
+    }
+    _loop_hz = MAX(loop_hz, 50.0f);
+    _gyro_hz = gyro_filt_hz;
+    _filt_hz = MAX(filt_hz, 1.0f);
+    _tc = MAX(act_tc, 0.0f);
+    _dly = MAX(act_dly, 0.0f);
+    _dt = 1.0f / _loop_hz;
+
+    _a_act = _dt / (_dt + _tc);
+    const float rc = 1.0f / (M_2PI * _filt_hz);
+    _a_h = _dt / (_dt + rc);
+    _n_dly = MIN(uint8_t(lrintf(_dly * _loop_hz)), uint8_t(DELAY_MAX - 1));
+    _gyro_sync.set_cutoff_frequency(_loop_hz, _gyro_hz);
+    _seeded = false;
+}
+
+float AC_INDI_Axis::step_actuator(float u_applied)
+{
+    // pure delay (ring buffer), then first-order lag
+    _dly_buf[_dly_idx] = u_applied;
+    const uint8_t out_idx = (_dly_idx + DELAY_MAX - _n_dly) % DELAY_MAX;
+    const float delayed = _dly_buf[out_idx];
+    _dly_idx = (_dly_idx + 1) % DELAY_MAX;
+    _u_act += _a_act * (delayed - _u_act);
+    return _u_act;
+}
+
+void AC_INDI_Axis::reset(float rate, float u_applied)
+{
+    for (float &b : _dly_buf) {
+        b = u_applied;
+    }
+    _u_act = u_applied;
+    _u_prev = u_applied;
+    _gyro_sync.reset(u_applied);
+    _hu1 = _hu2 = u_applied;
+    _rate_prev = rate;
+    _hw1 = _hw2 = 0.0f;
+    nu = wdot_f = 0.0f;
+    u0_f = u = u_applied;
+    _seeded = true;
+}
+
+float AC_INDI_Axis::update(float rate, float u_applied, float nu_in, float G)
+{
+    if (!_seeded) {
+        reset(rate, u_applied);
+    }
+
+    // measured angular acceleration: backward difference, then H
+    const float wdot_raw = (rate - _rate_prev) * _loop_hz;
+    _rate_prev = rate;
+    _hw1 += _a_h * (wdot_raw - _hw1);
+    _hw2 += _a_h * (_hw1 - _hw2);
+
+    // effector feedback through the same chain: actuator model, the half
+    // sample of the backward difference, the INS gyro filter, then H
+    const float ua = step_actuator(u_applied);
+    const float uh = 0.5f * (ua + _u_prev);
+    _u_prev = ua;
+    const float ug = is_positive(_gyro_hz) ? _gyro_sync.apply(uh) : uh;
+    _hu1 += _a_h * (ug - _hu1);
+    _hu2 += _a_h * (_hu1 - _hu2);
+
+    nu = nu_in;
+    wdot_f = _hw2;
+    u0_f = _hu2;
+    const float G_safe = MAX(G, 1.0f);
+    u = constrain_float(u0_f + (nu - wdot_f) / G_safe, -1.0f, 1.0f);
+    return u;
+}
diff --git a/libraries/AC_AttitudeControl/AC_INDI.h b/libraries/AC_AttitudeControl/AC_INDI.h
new file mode 100644
index 0000000000..f0fcd5e0c6
--- /dev/null
+++ b/libraries/AC_AttitudeControl/AC_INDI.h
@@ -0,0 +1,90 @@
+#pragma once
+
+/*
+  Incremental Nonlinear Dynamic Inversion (INDI) for the body-rate loop.
+
+  One AC_INDI_Axis per controlled axis. Each cycle:
+
+      nu      = K * (rate_target - rate)                 desired angular accel
+      wdot_f  = H( d/dt rate )                           measured angular accel
+      u0_f    = H( F_gyro( A( u_applied ) ) )            effector state, synchronised
+      u       = u0_f + (nu - wdot_f) / G                 new effector command
+
+  rate      gyro rate the caller already uses (INS low-pass applied, F_gyro)
+  A(s)      actuator model  exp(-s T) / (1 + s tau)
+  F_gyro    copy of the INS gyro low-pass, so u0 sees the same lag as the gyro
+  H(s)      second order low-pass, two equal real poles at FILT_HZ
+  G         effectiveness, rad/s^2 per unit normalised command
+
+  The u0 path gets every filter and delay the angular-acceleration path has
+  (including the half sample of the backward difference), so the two signals
+  line up in time. Without that the loop limit-cycles.
+ */
+
+#include <AP_Common/AP_Common.h>
+#include <AP_Param/AP_Param.h>
+#include <Filter/LowPassFilter2p.h>
+
+class AC_INDI_Params {
+public:
+    AC_INDI_Params();
+    CLASS_NO_COPY(AC_INDI_Params);
+
+    enum Axis : uint8_t {
+        MC_ROLL  = 1U << 0,
+        MC_PITCH = 1U << 1,
+        MC_YAW   = 1U << 2,
+        FW_ROLL  = 1U << 3,
+        FW_PITCH = 1U << 4,
+    };
+    bool axis_enabled(Axis a) const { return enable > 0 && (uint8_t(axes.get()) & a) != 0; }
+
+    AP_Int8  enable;
+    AP_Int8  axes;
+    AP_Float filt_hz;
+    AP_Float k[3];          // rate error gain, 1/s (roll, pitch, yaw)
+    AP_Float g[3];          // rotor effectiveness, rad/s^2 per unit mixer input
+    AP_Float act_tc;        // rotor actuator time constant, s
+    AP_Float act_dly;       // rotor actuator delay, s
+    AP_Float fw_g[2];       // surface effectiveness at speed scaler 1 (roll, pitch)
+    AP_Float fw_tc;         // surface actuator time constant, s
+    AP_Float fw_k[2];       // surface rate error gain, 1/s
+
+    static const struct AP_Param::GroupInfo var_info[];
+};
+
+class AC_INDI_Axis {
+public:
+    // (re)configure filters; cheap to call every loop, only acts on a change
+    void configure(float loop_hz, float gyro_filt_hz, float filt_hz, float act_tc, float act_dly);
+
+    // one INDI step; returns the new normalised effector command
+    float update(float rate, float u_applied, float nu, float G);
+
+    // seed all states so a later switch to INDI is bumpless
+    void reset(float rate, float u_applied);
+
+    // last values, for logging
+    float nu = 0, wdot_f = 0, u0_f = 0, u = 0;
+
+private:
+    static constexpr uint8_t DELAY_MAX = 16;
+
+    float step_actuator(float u_applied);
+
+    float _loop_hz = -1, _gyro_hz = -1, _filt_hz = -1, _tc = -1, _dly = -1;
+    float _dt = 0.0025f;
+    float _a_act = 1;       // first-order actuator coefficient
+    float _a_h = 1;         // first-order coefficient of each H pole
+    uint8_t _n_dly = 0;
+    float _dly_buf[DELAY_MAX] {};
+    uint8_t _dly_idx = 0;
+
+    float _u_act = 0;       // actuator model state
+    float _u_prev = 0;      // for the half-sample of the backward difference
+    LowPassFilter2pFloat _gyro_sync;
+    float _hu1 = 0, _hu2 = 0;   // H on u0
+    float _rate_prev = 0;
+    float _hw1 = 0, _hw2 = 0;   // H on d/dt rate
+    bool _seeded = false;
+};
