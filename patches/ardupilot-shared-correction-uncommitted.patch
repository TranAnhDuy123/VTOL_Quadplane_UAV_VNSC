+void AC_INDI_Share::report(Effector e, uint8_t axis, float G)
+{
+    if (axis > 1) {
+        return;
+    }
+    _g[e][axis] = MAX(G, 0.0f);
+    _us[e][axis] = AP_HAL::micros();
+}
+
+float AC_INDI_Share::other_sq(Effector e, uint8_t axis) const
+{
+    if (axis > 1) {
+        return 0.0f;
+    }
+    const uint8_t o = (e == MOTORS) ? SURFACES : MOTORS;
+    if (_us[o][axis] == 0 || AP_HAL::micros() - _us[o][axis] > STALE_US) {
+        return 0.0f;
+    }
+    return sq(_g[o][axis]);
+}
