From 9eebb043db26f282f1c0257eed3cd29c0de6309a Mon Sep 17 00:00:00 2001
From: TranAnhDuy123 <tranminhhuyen22@gmail.com>
Date: Fri, 25 Sep 2026 15:42:10 +0700
Subject: [PATCH 1/3] SITL: JSON: use reported wind when computing airspeed

velocity_wind was only copied into wind_ef after airspeed had been
computed from ground velocity with the wind forced to zero, so in a
windy simulator world the reported airspeed was the ground speed.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 libraries/SITL/SIM_JSON.cpp | 27 +++++++++++++--------------
 1 file changed, 13 insertions(+), 14 deletions(-)

diff --git a/libraries/SITL/SIM_JSON.cpp b/libraries/SITL/SIM_JSON.cpp
index bba93e8a98..61dcc8c6f8 100644
--- a/libraries/SITL/SIM_JSON.cpp
+++ b/libraries/SITL/SIM_JSON.cpp
@@ -434,30 +434,29 @@ void JSON::recv_fdm(const struct sitl_input &input)
         dcm.from_euler(state.attitude[0], state.attitude[1], state.attitude[2]);
     }
 
+    // wind (velocity of the air mass, earth frame) if the simulator reports it
+    if ((received_bitmask & WIND_VEL) != 0) {
+        wind_ef = state.velocity_wind;
+    } else {
+        wind_ef.zero();
+    }
+
+    // velocity relative to airmass in Earth's frame
+    velocity_air_ef = velocity_ef - wind_ef;
+
+    // velocity relative to airmass in body frame
+    velocity_air_bf = dcm.transposed() * velocity_air_ef;
+
     if ((received_bitmask & AIRSPEED)) {
         // received airspeed directly
         airspeed = state.airspeed;
 
         airspeed_pitot = state.airspeed;
     } else {
-        
-        // wind is not supported yet for JSON sim, assume zero for now        
-        wind_ef.zero(); 
-
-        // velocity relative to airmass in Earth's frame
-        velocity_air_ef = velocity_ef - wind_ef;
-
-        // velocity relative to airmass in body frame
-        velocity_air_bf = dcm.transposed() * velocity_air_ef;
-
         // airspeed fix for eas2tas
         update_eas_airspeed();
     }
 
-    if ((received_bitmask & WIND_VEL) != 0) {
-        wind_ef = state.velocity_wind;
-    }
-
     // Convert from a meters from origin physics to a lat long alt
     update_position();
 
