+void AC_INDI_Share::report(Effector e, uint8_t axis, float G, int8_t sat_dir)
+{
+    if (axis > 1) {
+        return;
+    }
+    _g[e][axis] = MAX(G, 0.0f);
+    _sat[e][axis] = sat_dir;
+    _us[e][axis] = AP_HAL::micros();
+}
+
+bool AC_INDI_Share::fresh(uint8_t e, uint8_t axis) const
+{
+    return _us[e][axis] != 0 && AP_HAL::micros() - _us[e][axis] <= STALE_US;
+}
+
+bool AC_INDI_Share::surfaces_first(uint8_t axis) const
+{
+    return axis <= 1 && _surfaces_first && fresh(SURFACES, axis) && is_positive(_g[SURFACES][axis]);
+}
+
+float AC_INDI_Share::other_sq(Effector e, uint8_t axis, int8_t dir) const
+{
+    if (axis > 1) {
+        return 0.0f;
+    }
+    const uint8_t o = (e == MOTORS) ? SURFACES : MOTORS;
+    if (!fresh(o, axis)) {
+        return 0.0f;
+    }
+    if (dir != 0 && _sat[o][axis] == dir) {
+        // the other set cannot move further this way: redistribute
+        return 0.0f;
+    }
+    return sq(_g[o][axis]);
+}
