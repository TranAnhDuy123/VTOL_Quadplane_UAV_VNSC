diff --git a/libraries/AC_AttitudeControl/AC_INDI.h b/libraries/AC_AttitudeControl/AC_INDI.h
index da70a741b7..e5790972a7 100644
--- a/libraries/AC_AttitudeControl/AC_INDI.h
+++ b/libraries/AC_AttitudeControl/AC_INDI.h
@@ -19,12 +19,65 @@
   The u0 path gets every filter and delay the angular-acceleration path has
   (including the half sample of the backward difference), so the two signals
   line up in time. Without that the loop limit-cycles.
+
+  Lift motors and control surfaces act on the same roll/pitch axis during
+  hover, transition and assisted flight. Each set runs its own AC_INDI_Axis,
+  but the correction is allocated between them (minimum-norm split):
+
+      u_i = u0_f,i + G_i (nu - wdot_f) / (G_motor^2 + G_surface^2)
+
+  so the moments add up to nu - wdot_f once, not once per effector set.
+  Each loop reports the G it used through AC_INDI_Share; a loop that did not
+  run INDI this cycle reports 0 or goes stale, and drops out of the sum.
+
+  Saturation: when the control surfaces are at full travel in the direction
+  of the needed correction, they cannot deliver their share, so the lift
+  motors leave them out of the sum and take the whole remaining correction
+  in the same step (redistribution).
+
+  Surfaces first: in a fixed-wing mode above the minimum airspeed the
+  surfaces are the primary effector. They take the whole correction; the
+  lift motors (running only because of assist) take it only while the
+  surfaces are saturated in the needed direction, and otherwise fade their
+  roll/pitch command to zero (time constant FADE_TC) so that the two sets
+  never settle holding opposite commands.
  */
 
 #include <AP_Common/AP_Common.h>
 #include <AP_Param/AP_Param.h>
 #include <Filter/LowPassFilter2p.h>
 
+// Effectiveness each effector set used in its last INDI step, per roll/pitch
+// axis, so the other set can include it in the allocation denominator.
+class AC_INDI_Share {
+public:
+    enum Effector : uint8_t { MOTORS = 0, SURFACES = 1 };
+
+    // sat_dir: +1 / -1 if this set is at its limit in that direction, else 0
+    void report(Effector e, uint8_t axis, float G, int8_t sat_dir = 0);
+
+    // G^2 of the other effector set on this axis; 0 if it did not run INDI
+    // recently, or if it is saturated in direction dir (dir = 0: ignore saturation)
+    float other_sq(Effector e, uint8_t axis, int8_t dir = 0) const;
+
+    // set by the vehicle every loop: wing-borne, surfaces are the primary effector
+    void set_surfaces_first(bool on) { _surfaces_first = on; }
+    // true if surfaces-first applies to this axis now (flag set and surfaces running INDI)
+    bool surfaces_first(uint8_t axis) const;
+    // saturation direction last reported by the surfaces on this axis
+    int8_t surface_sat(uint8_t axis) const { return axis > 1 ? 0 : _sat[SURFACES][axis]; }
+
+    static constexpr float FADE_TC = 0.5f;   // s, motor roll/pitch fade in surfaces-first
+
+private:
+    bool fresh(uint8_t e, uint8_t axis) const;
+    bool _surfaces_first {};
+    static constexpr uint32_t STALE_US = 10000;
+    float _g[2][2] {};
+    uint32_t _us[2][2] {};
+    int8_t _sat[2][2] {};
+};
